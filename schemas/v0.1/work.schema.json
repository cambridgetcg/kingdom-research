{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thekingdom.dev/research/schemas/v0.1/work.schema.json",
  "title": "KINGDOM exact-identifier research work 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "id", "primaryIdentifier", "identifiers", "title", "authors",
    "recordTypes", "firstPublishedOn", "latestObservedAt", "languages",
    "subjects", "reviewStates", "status", "itemLicenses", "versions", "relations",
    "observationIds", "sourceIds", "lifecycle", "paths"
  ],
  "properties": {
    "schema": { "const": "kingdom.research-work/0.1" },
    "id": { "type": "string", "pattern": "^work:[0-9a-f]{20}$" },
    "primaryIdentifier": { "$ref": "#/$defs/identifier" },
    "identifiers": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/identifier" } },
    "title": { "$ref": "#/$defs/line" },
    "authors": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/line" } },
    "recordTypes": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "enum": ["publication", "preprint", "dataset", "software", "trial", "status-update"] } },
    "firstPublishedOn": { "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
    "latestObservedAt": { "$ref": "#/$defs/instant" },
    "languages": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z]{2,3}$" } },
    "subjects": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/line" } },
    "reviewStates": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "enum": ["peer-reviewed", "preprint", "registered-study", "dataset", "software", "status-notice", "unknown"] } },
    "status": { "enum": ["active", "corrected", "retracted", "withdrawn", "unknown"] },
    "itemLicenses": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/line" } },
    "versions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "observedAt", "publishedOn", "status", "observationId"],
        "properties": {
          "label": { "$ref": "#/$defs/line" },
          "observedAt": { "$ref": "#/$defs/instant" },
          "publishedOn": { "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
          "status": { "enum": ["active", "corrected", "retracted", "withdrawn", "unknown"] },
          "observationId": { "type": "string", "pattern": "^observation:[a-z0-9-]+:[0-9a-f]{16}$" }
        }
      }
    },
    "relations": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "identifier", "source", "assertedAt", "recordId"],
        "properties": {
          "type": { "enum": ["is-preprint-of", "has-preprint", "is-version-of", "has-version", "is-supplement-to", "is-supplemented-by", "updates", "is-updated-by", "corrects", "is-corrected-by", "retracts", "is-retracted-by"] },
          "identifier": { "$ref": "#/$defs/identifier" },
          "source": { "oneOf": [{ "$ref": "#/$defs/line" }, { "type": "null" }] },
          "assertedAt": { "oneOf": [{ "$ref": "#/$defs/instant" }, { "type": "null" }] },
          "recordId": { "oneOf": [{ "$ref": "#/$defs/line" }, { "type": "null" }] }
        }
      }
    },
    "observationIds": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^observation:[a-z0-9-]+:[0-9a-f]{16}$" } },
    "sourceIds": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" } },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discovery", "evaluation", "adoption", "use"],
      "properties": {
        "discovery": { "const": "observed" },
        "evaluation": { "const": "not-performed" },
        "adoption": { "const": "not-recorded" },
        "use": { "const": "not-authorized" }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "guest"],
      "properties": {
        "module": { "$ref": "#/$defs/unproposedPath" },
        "guest": { "$ref": "#/$defs/unproposedPath" }
      }
    }
  },
  "$defs": {
    "line": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "instant": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "identifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "value"],
      "properties": {
        "scheme": { "enum": ["doi", "pmid", "pmcid", "arxiv", "nct", "openalex", "datacite-doi", "source"] },
        "value": { "$ref": "#/$defs/line" }
      }
    },
    "unproposedPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "requiresSeparateEvaluation", "requiresSeparateAdoption", "requiresSeparateUseAuthority"],
      "properties": {
        "state": { "const": "not-proposed" },
        "requiresSeparateEvaluation": { "const": true },
        "requiresSeparateAdoption": { "const": true },
        "requiresSeparateUseAuthority": { "const": true }
      }
    }
  }
}
