{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thekingdom.dev/research/schemas/v0.1/watchlist.schema.json",
  "title": "KINGDOM research watchlist 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "name", "need", "keywords", "languageScope", "priorityFactors"],
  "properties": {
    "schema": { "const": "kingdom.research-watchlist/0.1" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "maxLength": 80 },
    "name": { "$ref": "#/$defs/line" },
    "need": { "$ref": "#/$defs/line" },
    "keywords": {
      "type": "array",
      "minItems": 3,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 2, "maxLength": 96 }
    },
    "languageScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queryLanguage", "multilingualExpansion"],
      "properties": {
        "queryLanguage": { "const": "en" },
        "multilingualExpansion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "reason"],
          "properties": {
            "state": { "const": "absent" },
            "reason": { "$ref": "#/$defs/line" }
          }
        }
      }
    },
    "priorityFactors": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["factor", "reason"],
        "properties": {
          "factor": { "enum": ["named-need-fit", "freshness", "source-authority", "review-state", "integrity", "rights-clarity"] },
          "reason": { "$ref": "#/$defs/line" }
        }
      }
    }
  },
  "$defs": {
    "line": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$" }
  }
}
