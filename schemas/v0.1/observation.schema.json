{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thekingdom.dev/research/schemas/v0.1/observation.schema.json",
  "title": "KINGDOM inert research observation 0.1",
  "description": "One source report bound to metadata bytes. It is not an evaluation, adoption, use authority, or execution instruction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "id", "sourceId", "sourceRecordId", "observedAt",
    "upstreamCreatedAt", "upstreamUpdatedAt", "recordType", "canonicalUrl", "title", "authors",
    "publishedOn", "language", "subjects", "identifiers", "relations",
    "reviewState", "status", "sourceStatus", "version", "itemLicense", "payloadReceipt",
    "payloadBytes", "synthetic", "inert"
  ],
  "properties": {
    "schema": { "const": "kingdom.research-observation/0.1" },
    "id": { "type": "string", "pattern": "^observation:[a-z0-9-]+:[0-9a-f]{16}$" },
    "sourceId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "sourceRecordId": { "$ref": "#/$defs/line" },
    "observedAt": { "$ref": "#/$defs/instant" },
    "upstreamCreatedAt": { "$ref": "#/$defs/nullableInstant" },
    "upstreamUpdatedAt": { "$ref": "#/$defs/nullableInstant" },
    "recordType": { "enum": ["publication", "preprint", "dataset", "software", "trial", "status-update"] },
    "canonicalUrl": { "$ref": "#/$defs/url" },
    "title": { "$ref": "#/$defs/line" },
    "authors": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "orcid"],
        "properties": {
          "name": { "$ref": "#/$defs/line" },
          "orcid": { "oneOf": [{ "$ref": "#/$defs/orcid" }, { "type": "null" }] }
        }
      }
    },
    "publishedOn": { "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
    "language": { "oneOf": [{ "type": "string", "pattern": "^[a-z]{2,3}$" }, { "type": "null" }] },
    "subjects": { "$ref": "#/$defs/lines" },
    "identifiers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "relations": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "identifier", "source", "assertedAt", "recordId"],
        "properties": {
          "type": { "enum": ["is-preprint-of", "has-preprint", "is-version-of", "has-version", "is-supplement-to", "is-supplemented-by", "updates", "is-updated-by", "corrects", "is-corrected-by", "retracts", "is-retracted-by"] },
          "identifier": { "$ref": "#/$defs/identifier" },
          "source": { "oneOf": [{ "$ref": "#/$defs/line" }, { "type": "null" }] },
          "assertedAt": { "$ref": "#/$defs/nullableInstant" },
          "recordId": { "oneOf": [{ "$ref": "#/$defs/line" }, { "type": "null" }] }
        }
      }
    },
    "reviewState": { "enum": ["peer-reviewed", "preprint", "registered-study", "dataset", "software", "status-notice", "unknown"] },
    "status": { "enum": ["active", "corrected", "retracted", "withdrawn", "unknown"] },
    "sourceStatus": { "oneOf": [{ "$ref": "#/$defs/line" }, { "type": "null" }] },
    "version": { "$ref": "#/$defs/line" },
    "itemLicense": { "oneOf": [{ "$ref": "#/$defs/line" }, { "type": "null" }] },
    "payloadReceipt": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "payloadBytes": { "type": "integer", "minimum": 2, "maximum": 1048576 },
    "synthetic": { "type": "boolean" },
    "inert": { "const": true }
  },
  "$defs": {
    "line": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$" },
    "lines": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/line" } },
    "url": { "type": "string", "pattern": "^https://[^/?#@]+(?:/[^#]*)?$", "maxLength": 2048 },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "instant": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "nullableInstant": { "oneOf": [{ "$ref": "#/$defs/instant" }, { "type": "null" }] },
    "orcid": { "type": "string", "pattern": "^https://orcid.org/[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{3}[0-9X]$" },
    "identifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "value"],
      "properties": {
        "scheme": { "enum": ["doi", "pmid", "pmcid", "arxiv", "nct", "openalex", "datacite-doi", "source"] },
        "value": { "$ref": "#/$defs/line" }
      }
    }
  }
}
