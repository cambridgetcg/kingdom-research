{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thekingdom.dev/research/schemas/v0.1/fixture-set.schema.json",
  "title": "KINGDOM synthetic research fixture set 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "asOf", "synthetic", "metadataOnly", "fixtures"],
  "properties": {
    "schema": { "const": "kingdom.research-fixture-set/0.1" },
    "asOf": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "synthetic": { "const": true },
    "metadataOnly": { "const": true },
    "fixtures": {
      "type": "array",
      "minItems": 7,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sourceId", "adapter", "path", "observedAt"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
          "sourceId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
          "adapter": { "enum": ["crossref", "datacite", "openalex", "pubmed", "arxiv", "europe-pmc", "biorxiv", "clinicaltrials-gov", "crossref-updates"] },
          "path": { "type": "string", "pattern": "^raw/[a-z0-9][a-z0-9.-]+\\.(?:json|xml)$" },
          "observedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" }
        }
      }
    }
  }
}
